{
  "name": "rv32-development",
  "displayName": "Insper RISC-V Live",
  "description": "Create, simulate, and program C and Rust applications for the Insper RV32 processor.",
  "version": "0.5.0",
  "publisher": "insper-riscv",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/insper-riscv/Live"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "risc-v",
    "rv32im",
    "fpga",
    "c",
    "insper"
  ],
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false
    },
    "untrustedWorkspaces": {
      "supported": false,
      "description": "RV32 tasks compile and execute files from the current workspace."
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:rv32.createCProject",
    "onCommand:rv32.initializeCWorkspace",
    "onCommand:rv32.selectSdk",
    "onCommand:rv32.prepare",
    "onCommand:rv32.doctor",
    "onCommand:rv32.simulate",
    "onCommand:rv32.fpgaFull",
    "onCommand:rv32.fpgaFast",
    "onCommand:rv32.fpgaReuse",
    "onCommand:rv32.readStdout",
    "onCommand:rv32.reopenInContainer",
    "onTaskType:rv32",
    "workspaceContains:rv32.toml",
    "onLanguage:c",
    "onLanguage:rust"
  ],
  "extensionPack": [
    "ms-vscode.cpptools",
    "ms-vscode-remote.remote-containers"
  ],
  "contributes": {
    "commands": [
      {
        "command": "rv32.createCProject",
        "title": "RV32: Create New C Project"
      },
      {
        "command": "rv32.initializeCWorkspace",
        "title": "RV32: Add C Infrastructure to Current Folder"
      },
      {
        "command": "rv32.selectSdk",
        "title": "RV32: Select SDK Folder"
      },
      {
        "command": "rv32.prepare",
        "title": "RV32: Prepare Project"
      },
      {
        "command": "rv32.doctor",
        "title": "RV32: Check Environment"
      },
      {
        "command": "rv32.simulate",
        "title": "RV32: Simulate",
        "icon": "$(beaker)"
      },
      {
        "command": "rv32.fpgaFull",
        "title": "RV32: Program FPGA",
        "icon": "$(circuit-board)"
      },
      {
        "command": "rv32.fpgaFast",
        "title": "RV32: Fast Update FPGA",
        "icon": "$(play)"
      },
      {
        "command": "rv32.fpgaReuse",
        "title": "RV32: FPGA Reuse Existing SOF"
      },
      {
        "command": "rv32.readStdout",
        "title": "RV32: Read FPGA stdout"
      },
      {
        "command": "rv32.reopenInContainer",
        "title": "RV32: Reopen Project in Dev Container"
      },
      {
        "command": "rv32.toggleDebugOutput",
        "title": "RV32: Toggle Debug Output"
      }
    ],
    "configuration": {
      "title": "RV32 Development",
      "properties": {
        "rv32.sdkPath": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Optional RV32 SDK path. When empty, ~/.local/share/rv32-sdk is used on the host and /opt/rv32-sdk inside the Dev Container."
        },
        "rv32.openCreatedProjectInNewWindow": {
          "type": "boolean",
          "default": true,
          "description": "Open newly created projects in a new VS Code window."
        },
        "rv32.debug": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Show tool commands, compiler warnings, simulator messages and FPGA diagnostics. Disabled: display only program stdout and a concise failure message."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "rv32",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "prepare",
              "doctor",
              "simulate",
              "fpga-full",
              "fpga-fast",
              "fpga-reuse",
              "stdout"
            ]
          }
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "rv32.simulate",
          "when": "(resourceLangId == c || resourceLangId == rust) && rv32.project",
          "group": "navigation@3"
        },
        {
          "command": "rv32.fpgaFast",
          "when": "(resourceLangId == c || resourceLangId == rust) && rv32.project",
          "group": "navigation@2"
        },
        {
          "command": "rv32.fpgaFull",
          "when": "(resourceLangId == c || resourceLangId == rust) && rv32.project",
          "group": "navigation@1"
        }
      ]
    }
  },
  "scripts": {
    "check": "node --check extension.js && node --check src/core.js",
    "test": "npm run check && node --test",
    "package": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && vsce package --no-dependencies --follow-symlinks --out dist/rv32-development-0.5.0.vsix"
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "homepage": "https://github.com/insper-riscv/Live#readme",
  "bugs": {
    "url": "https://github.com/insper-riscv/Live/issues"
  }
}
